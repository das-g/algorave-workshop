$: note("[~ [<[d3,a3,f4]!2 [d3,bb3,g4]!2> ~]]*2")
.sound("gm_electric_guitar_muted")

$: sound("bd rim").bank("RolandTR707")

$: n("<4 [3!3 4] [<2 0> ~!16] ~>")
.scale("D4:minor").sound("gm_accordion:2")

$: n("[0 [~ 0] 4 [3 2] [0 ~] [0 ~] <0 2> ~]/2")
.scale("D2:minor")
.sound("sawtooth,triangle")
